#!/usr/bin/env bash
# Syncro Maven Wrapper script
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure JAVA_HOME is set if not already present
if [ -z "$JAVA_HOME" ]; then
    if [ -d "/usr/lib/jvm/java-21-openjdk-amd64" ]; then
        export JAVA_HOME="/usr/lib/jvm/java-21-openjdk-amd64"
    elif [ -d "/usr/lib/jvm/java-25-openjdk-amd64" ]; then
        export JAVA_HOME="/usr/lib/jvm/java-25-openjdk-amd64"
    fi
fi

if [ -x "/tmp/apache-maven-3.9.9/bin/mvn" ]; then
    exec "/tmp/apache-maven-3.9.9/bin/mvn" "$@"
elif command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
else
    echo "Maven binary not found. Please install Maven or ensure /tmp/apache-maven-3.9.9/bin/mvn exists." >&2
    exit 1
fi

